# Copy to utils/ntfy.env (gitignored) and fill in.
# On your phone: open ntfy app → Subscribe to topic → same NTFY_TOPIC value.
# Use a long random topic name so strangers cannot spam you.

NTFY_TOPIC=gutomics-REPLACE-WITH-RANDOM-STRING
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=   # only if you use a protected topic / self-hosted ntfy
# NTFY_PRIORITY=3
# NTFY_TAGS=warning
